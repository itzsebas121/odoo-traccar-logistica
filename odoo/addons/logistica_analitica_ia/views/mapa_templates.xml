<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mapa_pagina" name="Mapa de la ruta sugerida">
        <t t-call="web.layout">
            <t t-set="title">Ruta sugerida</t>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <link rel="stylesheet" href="/logistica_base/static/lib/leaflet/leaflet.css"
                      integrity="sha256-M3v8pcq9A7OYFbJwD+vis7ft9VkhxZzUn4jssyghIwM="/>
                <script src="/logistica_base/static/lib/leaflet/leaflet.js"
                        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="></script>
                <script type="text/javascript" src="/logistica_analitica_ia/static/src/js/mapa.js"></script>
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&amp;family=JetBrains+Mono:wght@400;500;600;700&amp;display=swap"/>
                <style>
                    html, body { height: 100%; margin: 0; font-family: 'IBM Plex Sans', ui-sans-serif, sans-serif; background: #F8F5EE; color: #141D2B; }
                    #prediccion-barra { padding: 10px 16px; background: #131B29; color: #FDFBF7; border-bottom: 2px solid #E06D2B; font-size: 13px; }
                    #prediccion-barra strong { font-family: 'JetBrains Mono', monospace; color: #E06D2B; text-transform: uppercase; letter-spacing: 0.04em; margin-right: 6px; }
                    #prediccion-mapa { height: calc(100% - 44px); }
                </style>
            </t>
            <div id="prediccion-barra">
                <strong>Ruta sugerida:</strong>
                <span t-esc="origen"/> → <span t-esc="destino"/>
                <span t-if="consulta.route_source">
                    · <span t-esc="'%.2f' % consulta.route_distance_km"/> km ·
                    fuente: <span t-esc="consulta.route_source"/>
                </span>
                <span t-if="consulta.route_source == 'estimado_haversine'"> (estimación, no es ruta por carretera)</span>
            </div>
            <div id="prediccion-mapa" t-att-data-geometria="geometria"></div>
        </t>
    </template>
</odoo>
