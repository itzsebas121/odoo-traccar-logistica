<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="logistica_tablero.TableroIndicadores" owl="1">
        <div class="o_action o_lt_tablero">
            <div class="o_lt_cabecera">
                <div>
                    <div class="o_lt_antetitulo">Analítica</div>
                    <h1 class="o_lt_titulo">Indicadores logísticos</h1>
                </div>
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.cargar()" t-att-disabled="state.cargando">
                    <i class="fa fa-refresh me-1" t-att-class="{'fa-spin': state.cargando}"/>Actualizar
                </button>
            </div>

            <div class="o_lt_filtros">
                <label>
                    <span>Periodo</span>
                    <select class="form-select form-select-sm" t-on-change="(ev) => this.cambiarFiltro('periodo', ev)">
                        <t t-foreach="periodos" t-as="p" t-key="p.id">
                            <option t-att-value="p.id" t-att-selected="state.filtros.periodo === p.id"><t t-esc="p.nombre"/></option>
                        </t>
                    </select>
                </label>
                <t t-if="state.filtros.periodo === 'rango'">
                    <label><span>Desde</span>
                        <input type="date" class="form-control form-control-sm" t-att-value="state.filtros.desde"
                               t-on-change="(ev) => this.cambiarFiltro('desde', ev)"/></label>
                    <label><span>Hasta</span>
                        <input type="date" class="form-control form-control-sm" t-att-value="state.filtros.hasta"
                               t-on-change="(ev) => this.cambiarFiltro('hasta', ev)"/></label>
                </t>
                <label>
                    <span>Zona</span>
                    <select class="form-select form-select-sm" t-on-change="(ev) => this.cambiarFiltro('zona', ev)">
                        <option value="">Todas las zonas</option>
                        <t t-foreach="state.opciones.zonas" t-as="z" t-key="z.codigo">
                            <option t-att-value="z.codigo" t-att-selected="state.filtros.zona === z.codigo"><t t-esc="z.nombre"/></option>
                        </t>
                    </select>
                </label>
                <label t-if="state.pestana !== 'operacion'">
                    <span>Categoría</span>
                    <select class="form-select form-select-sm" t-on-change="(ev) => this.cambiarFiltro('categoria', ev)">
                        <option value="">Todas las categorías</option>
                        <t t-foreach="state.opciones.categorias" t-as="c" t-key="c">
                            <option t-att-value="c" t-att-selected="state.filtros.categoria === c"><t t-esc="c"/></option>
                        </t>
                    </select>
                </label>
                <label t-if="state.pestana === 'operacion'">
                    <span>Conductor</span>
                    <select class="form-select form-select-sm" t-on-change="(ev) => this.cambiarFiltro('conductor', ev)">
                        <option value="">Todos los conductores</option>
                        <t t-foreach="state.opciones.conductores" t-as="c" t-key="c">
                            <option t-att-value="c" t-att-selected="state.filtros.conductor === c"><t t-esc="c"/></option>
                        </t>
                    </select>
                </label>
                <label>
                    <span>Procedencia</span>
                    <select class="form-select form-select-sm" t-on-change="(ev) => this.cambiarFiltro('procedencia', ev)">
                        <option value="">Todas</option>
                        <option value="REAL" t-att-selected="state.filtros.procedencia === 'REAL'">Reales</option>
                        <option value="SIMULADO" t-att-selected="state.filtros.procedencia === 'SIMULADO'">Simuladas</option>
                    </select>
                </label>
            </div>

            <div class="o_lt_pestanas">
                <t t-foreach="pestanas" t-as="p" t-key="p.id">
                    <button t-att-class="{'o_lt_pestana': true, 'o_lt_activa': state.pestana === p.id}"
                            t-on-click="() => this.cambiarPestana(p.id)"><t t-esc="p.nombre"/></button>
                </t>
            </div>

            <div t-if="state.error" class="o_lt_aviso o_lt_error">
                <i class="fa fa-exclamation-circle me-2"/>
                <div><strong>No se pudieron cargar los datos.</strong><div t-esc="state.error"/></div>
            </div>
            <div t-elif="!state.datos" class="o_lt_aviso"><i class="fa fa-circle-o-notch fa-spin me-2"/>Cargando…</div>

            <!-- ============================================================ Resumen -->
            <t t-elif="state.pestana === 'resumen'">
                <div class="o_lt_rango">Del <t t-esc="state.datos.rango.desde"/> al <t t-esc="state.datos.rango.hasta"/>
                    <t t-if="state.datos.ultimo_dia"> · última venta: <t t-esc="state.datos.ultimo_dia"/></t>
                    <t t-if="state.datos.simulado.pedidos"> · <t t-esc="fmt.num(state.datos.simulado.pedidos)"/> de
                        <t t-esc="fmt.num(state.datos.simulado.total)"/> pedidos son de demostración (SIMULADO)</t>
                </div>
                <div class="o_lt_kpis">
                    <div class="o_lt_kpi"><span>Ventas</span><strong t-esc="fmt.dinero(state.datos.kpi.importe)"/>
                        <small t-esc="fmt.variacion(state.datos.kpi.variacion_importe_7d)"/></div>
                    <div class="o_lt_kpi"><span>Pedidos</span><strong t-esc="fmt.num(state.datos.kpi.pedidos)"/>
                        <small t-esc="fmt.variacion(state.datos.kpi.variacion_pedidos_7d)"/></div>
                    <div class="o_lt_kpi"><span>Ticket promedio</span><strong t-esc="fmt.dineroExacto(state.datos.kpi.ticket)"/></div>
                    <div class="o_lt_kpi"><span>Unidades vendidas</span><strong t-esc="fmt.num(state.datos.kpi.unidades)"/></div>
                </div>
                <div class="o_lt_rejilla">
                    <div class="o_lt_panel o_lt_ancho"><h3>Ventas por día</h3>
                        <div t-if="!diasResumen.length" class="o_lt_vacio">Sin ventas en el periodo.</div>
                        <div class="o_lt_grafico" t-att-class="{'d-none': !diasResumen.length}"><canvas t-ref="graficoVentas"/></div>
                    </div>
                    <div class="o_lt_panel"><h3>Pedidos por día</h3>
                        <div t-if="!diasResumen.length" class="o_lt_vacio">Sin pedidos.</div>
                        <div class="o_lt_grafico" t-att-class="{'d-none': !diasResumen.length}"><canvas t-ref="graficoPedidos"/></div>
                    </div>
                    <div class="o_lt_panel o_lt_completo">
                        <h3>Pronóstico del negocio (próximos 7 días)</h3>
                        <t t-set="neg" t-value="pronosticoNegocio"/>
                        <div t-if="!neg.hay" class="o_lt_vacio">Todavía no hay pronóstico disponible. Se publica automáticamente cuando el sistema lo calcula.</div>
                        <t t-else="">
                            <p class="o_lt_nota">Se esperan <strong t-esc="fmt.num(neg.total)"/> unidades
                                <t t-if="neg.cambio !== null">(<t t-esc="fmt.dec(neg.cambio)"/> % frente a las <t t-esc="fmt.num(neg.vendido)"/> de la última semana)</t>.</p>
                        </t>
                        <div class="o_lt_grafico" t-att-class="{'d-none': !neg.hay}"><canvas t-ref="graficoNegocio"/></div>
                    </div>
                </div>
            </t>

            <!-- ============================================================ Demanda -->
            <t t-elif="state.pestana === 'demanda'">
                <div class="o_lt_rango">Del <t t-esc="state.datos.rango.desde"/> al <t t-esc="state.datos.rango.hasta"/></div>
                <div class="o_lt_rejilla">
                    <div class="o_lt_panel o_lt_completo"><h3>¿Dónde se vende? (ubicación exacta de cada pedido)</h3>
                        <div t-if="!state.datos.puntos.length" class="o_lt_vacio">Ningún pedido del periodo tiene ubicación.</div>
                        <div class="o_lt_mapa" t-ref="mapa"/>
                    </div>
                    <div class="o_lt_panel"><h3>Ventas por categoría</h3>
                        <div class="o_lt_grafico"><canvas t-ref="graficoCategorias"/></div></div>
                    <div class="o_lt_panel"><h3>Ventas por zona</h3>
                        <div class="o_lt_grafico"><canvas t-ref="graficoZonas"/></div></div>
                    <div class="o_lt_panel o_lt_completo"><h3>Lo más vendido en cada zona</h3>
                        <div t-if="!state.datos.top_por_zona.length" class="o_lt_vacio">Sin ventas en el periodo.</div>
                        <div class="o_lt_top">
                            <t t-foreach="state.datos.top_por_zona" t-as="z" t-key="z.zona">
                                <div class="o_lt_top_zona"><h4 t-esc="z.nombre"/>
                                    <ol><t t-foreach="z.productos" t-as="pr" t-key="pr.producto_sk">
                                        <li><span t-esc="pr.producto"/> <small t-esc="fmt.num(pr.unidades) + ' u.'"/></li>
                                    </t></ol>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ============================================================ Pronóstico -->
            <t t-elif="state.pestana === 'pronostico'">
                <div t-if="state.datos.aviso" class="o_lt_aviso"><i class="fa fa-info-circle me-2"/><t t-esc="state.datos.aviso"/></div>
                <div t-else="" class="o_lt_rejilla">
                    <div class="o_lt_panel o_lt_ancho">
                        <div class="o_lt_panel_cab"><h3>Vendido y pronóstico</h3>
                            <select class="form-select form-select-sm" t-on-change="(ev) => this.cambiarProducto(ev)">
                                <option value="">Todos los productos</option>
                                <t t-foreach="productosPronostico" t-as="pr" t-key="pr.sk">
                                    <option t-att-value="pr.sk" t-att-selected="'' + state.producto === '' + pr.sk"><t t-esc="pr.nombre"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="o_lt_grafico"><canvas t-ref="graficoDetalle"/></div>
                        <p class="o_lt_nota" t-if="state.datos.actualizado_utc">Calculado: <t t-esc="state.datos.actualizado_utc"/> (UTC)</p>
                    </div>
                    <div class="o_lt_panel"><h3>Demanda esperada por ubicación</h3><div class="o_lt_mapa o_lt_mapa_chico" t-ref="mapa"/></div>
                    <div class="o_lt_panel o_lt_completo"><h3>Próximos 7 días por producto y zona</h3>
                        <div class="table-responsive"><table class="table table-sm o_lt_tabla">
                            <thead><tr><th>Producto</th><th>Zona</th><th class="text-end">Esperado</th>
                                <th class="text-end">Con margen</th><th class="text-end">Vendido última semana</th></tr></thead>
                            <tbody><t t-foreach="celdasOrdenadas" t-as="c" t-key="c.producto_sk + '|' + c.zona">
                                <tr><td t-esc="c.producto"/><td t-esc="nombreZona(c.zona)"/>
                                    <td class="text-end" t-esc="fmt.dec(c.unidades)"/>
                                    <td class="text-end" t-esc="fmt.dec(c.unidades_con_margen)"/>
                                    <td class="text-end" t-esc="fmt.dec(c.vendido_semana)"/></tr>
                            </t></tbody>
                        </table></div>
                    </div>
                </div>
            </t>

            <!-- ============================================================ Operación -->
            <t t-elif="state.pestana === 'operacion'">
                <div class="o_lt_rango">Del <t t-esc="state.datos.rango.desde"/> al <t t-esc="state.datos.rango.hasta"/></div>
                <div class="o_lt_kpis">
                    <div class="o_lt_kpi"><span>Entregas</span><strong t-esc="fmt.num(state.datos.kpi.entregas)"/>
                        <small><t t-esc="fmt.num(state.datos.kpi.entregadas)"/> entregadas · <t t-esc="fmt.num(state.datos.kpi.no_entregadas)"/> no entregadas</small></div>
                    <div class="o_lt_kpi"><span>A tiempo</span><strong t-esc="fmt.pct(state.datos.kpi.pct_a_tiempo)"/></div>
                    <div class="o_lt_kpi"><span>Rutas</span><strong t-esc="fmt.num(state.datos.kpi.rutas)"/>
                        <small><t t-esc="fmt.num(state.datos.kpi.rutas_con_gps)"/> con GPS</small></div>
                    <div class="o_lt_kpi"><span>Km planificados / reales</span>
                        <strong><t t-esc="fmt.num(state.datos.kpi.km_planificado)"/> / <t t-esc="fmt.num(state.datos.kpi.km_real)"/></strong></div>
                </div>
                <div class="o_lt_rejilla">
                    <div class="o_lt_panel o_lt_ancho"><h3>Entregas por día</h3>
                        <div t-if="!state.datos.por_dia.length" class="o_lt_vacio">Sin entregas en el periodo.</div>
                        <div class="o_lt_grafico"><canvas t-ref="graficoPorDia"/></div></div>
                    <div class="o_lt_panel"><h3>Km por conductor</h3>
                        <div t-if="!state.datos.conductores.length" class="o_lt_vacio">Sin rutas medidas con GPS.</div>
                        <div class="o_lt_grafico"><canvas t-ref="graficoConductores"/></div></div>
                    <div class="o_lt_panel o_lt_completo"><h3>Rutas: plan frente a lo real</h3>
                        <div t-if="!state.datos.rutas.length" class="o_lt_vacio">Sin rutas en el periodo.</div>
                        <div t-else="" class="table-responsive"><table class="table table-sm o_lt_tabla">
                            <thead><tr><th>Ruta</th><th>Fecha</th><th>Conductor</th><th>Placa</th>
                                <th class="text-end">Km plan</th><th class="text-end">Km real</th><th class="text-end">Desv. km</th>
                                <th class="text-end">Paradas</th><th class="text-end">% entregado</th></tr></thead>
                            <tbody><t t-foreach="state.datos.rutas" t-as="r" t-key="r.codigo">
                                <tr><td t-esc="r.codigo"/><td t-esc="r.fecha"/><td t-esc="r.conductor or '—'"/><td t-esc="r.placa or '—'"/>
                                    <td class="text-end" t-esc="fmt.dec(r.km_planificado)"/><td class="text-end" t-esc="fmt.dec(r.km_real)"/>
                                    <td class="text-end" t-esc="fmt.pct(r.desviacion_km_pct)"/><td class="text-end" t-esc="fmt.num(r.paradas_total)"/>
                                    <td class="text-end" t-esc="fmt.pct(r.pct_entregado)"/></tr>
                            </t></tbody>
                        </table></div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
