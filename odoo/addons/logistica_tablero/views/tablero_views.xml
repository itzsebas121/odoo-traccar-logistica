<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_tablero_indicadores" model="ir.actions.client">
        <field name="name">Indicadores logísticos</field>
        <field name="tag">logistica_tablero.tablero</field>
    </record>

    <!-- Dentro de la app Tableros de Odoo, junto a los tableros estándar -->
    <menuitem id="menu_tablero_indicadores_dashboards"
              name="Indicadores logísticos"
              parent="spreadsheet_dashboard.spreadsheet_dashboard_menu_root"
              action="action_tablero_indicadores"
              sequence="5"
              groups="sales_team.group_sale_manager,fleet.fleet_group_manager,base.group_system"/>

    <!-- Y desde el menú Logística -->
    <menuitem id="menu_tablero_indicadores_logistica"
              name="Indicadores"
              parent="logistica_base.menu_logistica_root"
              action="action_tablero_indicadores"
              sequence="5"
              groups="sales_team.group_sale_manager,fleet.fleet_group_manager,base.group_system"/>
</odoo>
