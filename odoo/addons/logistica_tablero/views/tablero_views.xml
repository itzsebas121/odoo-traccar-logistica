<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista suelta del tablero (la usa quien abra la accion directamente). En el menu, los indicadores estan dentro
         de la app Tableros (grupo LOGISTICA, static/src/tableros). -->
    <record id="action_tablero_indicadores" model="ir.actions.client">
        <field name="name">Indicadores logísticos</field>
        <field name="tag">logistica_tablero.tablero</field>
    </record>

    <!-- Logística → Indicadores abre la app Tableros, que muestra los indicadores por defecto -->
    <menuitem id="menu_tablero_indicadores_logistica"
              name="Indicadores"
              parent="logistica_base.menu_logistica_root"
              action="spreadsheet_dashboard.ir_actions_dashboard_action"
              sequence="5"
              groups="sales_team.group_sale_manager,fleet.fleet_group_manager,base.group_system"/>
</odoo>
