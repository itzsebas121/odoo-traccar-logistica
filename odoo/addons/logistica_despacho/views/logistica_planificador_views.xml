<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistica_planificador_form" model="ir.ui.view">
        <field name="name">logistica.planificador.form</field>
        <field name="model">logistica.planificador</field>
        <field name="arch" type="xml">
            <form string="Despachar">
                <p class="text-muted">
                    Se arman las rutas con todo lo que está listo para salir. Revise el resumen y pulse
                    «Proponer rutas»; luego apruebe las rutas para avisar a los conductores.
                </p>
                <group>
                    <field name="date"/>
                    <field name="vehicle_ids" widget="many2many_tags" context="{'logistica_con_conductor': True}"
                           placeholder="Todos los vehículos con conductor"/>
                    <field name="entrega_ids" widget="many2many_tags"
                           domain="[('estado_simple', '=', 'por_despachar'), ('state', '=', 'preparado')]"
                           placeholder="Todas las entregas listas (o seleccione pedidos específicos)"/>
                    <field name="bodega_id" groups="base.group_no_one"/>
                    <field name="time_limit_s" groups="base.group_no_one"/>
                </group>
                <field name="resumen" nolabel="1"/>
                <footer>
                    <button name="action_proponer" string="Proponer rutas" type="object" class="btn-primary"/>
                    <button string="Cerrar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_logistica_planificador" model="ir.actions.act_window">
        <field name="name">Despachar</field>
        <field name="res_model">logistica.planificador</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_entregas_por_despachar" model="ir.actions.act_window">
        <field name="name">Pedidos por despachar</field>
        <field name="res_model">logistica.entrega</field>
        <field name="view_mode">tree,form</field>
        <!-- Fase A: incluye también las que esperan preparación en bodega (antes no aparecían aquí). -->
        <field name="domain">[('estado_simple', '=', 'por_despachar')]</field>
    </record>
</odoo>
