<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Secuencia para códigos de ruta -->
    <record id="seq_logistica_ruta" model="ir.sequence">
        <field name="name">Secuencia de Rutas de Despacho</field>
        <field name="code">logistica.ruta</field>
        <field name="prefix">RUTA/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_logistica_ruta_form" model="ir.ui.view">
        <field name="name">logistica.ruta.form</field>
        <field name="model">logistica.ruta</field>
        <field name="arch" type="xml">
            <form string="Ruta de despacho">
                <header>
                    <button name="action_aprobar_plan" string="Aprobar plan" type="object"
                            class="oe_highlight" states="borrador" groups="fleet.fleet_group_manager"/>
                    <button name="action_confirmar_carga" string="Confirmar carga" type="object"
                            class="oe_highlight" states="planificada"/>
                    <button name="action_iniciar_recorrido" string="Iniciar recorrido" type="object"
                            class="btn-success" states="carga_confirmada"
                            confirm="Una vez iniciado el recorrido no se podrán agregar pedidos a la ruta. ¿Continuar?"/>
                    <button name="action_cerrar" string="Cerrar ruta" type="object"
                            class="btn-primary" states="en_recorrido"/>
                    <button name="action_open_google_maps_route" string="Ver ruta en mapa" type="object"
                            icon="fa-map" class="btn-info"
                            states="planificada,carga_confirmada,en_recorrido,cerrada,interrumpida"/>
                    <button name="action_abrir_interrumpir" string="Interrumpir" type="object"
                            states="en_recorrido"/>
                    <button name="action_abrir_cancelar" string="Cancelar" type="object"
                            states="borrador,planificada,carga_confirmada" groups="fleet.fleet_group_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="borrador,planificada,carga_confirmada,en_recorrido,cerrada"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Programación">
                            <field name="date" attrs="{'readonly': [('state', '!=', 'borrador')]}"/>
                            <field name="bodega_id" attrs="{'readonly': [('state', '!=', 'borrador')]}"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                        <group string="Asignación">
                            <field name="vehicle_id" attrs="{'readonly': [('state', '!=', 'borrador')]}"/>
                            <field name="driver_id" attrs="{'readonly': [('state', '!=', 'borrador')]}"/>
                            <field name="started_at" attrs="{'invisible': [('started_at', '=', False)]}"/>
                            <field name="finished_at" attrs="{'invisible': [('finished_at', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Planificación" attrs="{'invisible': [('planned_distance_km', '=', 0)]}">
                        <field name="planned_distance_km"/>
                        <field name="planned_duration_min"/>
                        <field name="distance_source"/>
                        <field name="optimization_version"/>
                    </group>
                    <group attrs="{'invisible': [('interrupt_reason', '=', False)]}">
                        <field name="interrupt_reason" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Paradas" name="stops">
                            <field name="stop_ids" attrs="{'readonly': [('state', '!=', 'borrador')]}">
                                <tree editable="bottom" decoration-success="state == 'entregado'"
                                      decoration-danger="state == 'no_entregado'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="entrega_id" attrs="{'readonly': [('state', '!=', 'pendiente')]}"/>
                                    <field name="partner_id"/>
                                    <field name="destination_address"/>
                                    <field name="state" readonly="1"/>
                                    <field name="arrival_candidate_at" optional="show"/>
                                    <field name="failed_reason"/>
                                    <field name="notes" optional="hide"/>
                                    <button name="action_open_navigation" string="Navegar" type="object"
                                            icon="fa-location-arrow"/>
                                    <button name="action_marcar_llegada" string="Llegada" type="object"
                                            icon="fa-map-marker"
                                            attrs="{'invisible': ['|', ('state', '!=', 'pendiente'), ('actual_arrival_at', '!=', False)]}"/>
                                    <button name="action_marcar_entregado" string="Entregado" type="object"
                                            icon="fa-check" class="text-success"
                                            attrs="{'invisible': [('state', '!=', 'pendiente')]}"/>
                                    <button name="action_ui_no_entregado" string="No entregado" type="object"
                                            icon="fa-times" class="text-danger"
                                            attrs="{'invisible': [('state', '!=', 'pendiente')]}"/>
                                    <field name="actual_arrival_at" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistica_ruta_tree" model="ir.ui.view">
        <field name="name">logistica.ruta.tree</field>
        <field name="model">logistica.ruta</field>
        <field name="arch" type="xml">
            <tree string="Rutas de despacho" decoration-muted="state in ('cancelada', 'interrumpida')"
                  decoration-success="state == 'cerrada'" decoration-info="state == 'en_recorrido'">
                <field name="name"/>
                <field name="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="total_stops"/>
                <field name="delivered_stops"/>
                <field name="failed_stops"/>
                <field name="progress" widget="progressbar"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_logistica_ruta_search" model="ir.ui.view">
        <field name="name">logistica.ruta.search</field>
        <field name="model">logistica.ruta</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter name="f_activas" string="Activas"
                        domain="[('state', 'in', ('borrador', 'planificada', 'carga_confirmada', 'en_recorrido'))]"/>
                <filter name="f_recorrido" string="En recorrido" domain="[('state', '=', 'en_recorrido')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="g_estado" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="g_fecha" string="Fecha" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_logistica_ruta" model="ir.actions.act_window">
        <field name="name">Rutas de despacho</field>
        <field name="res_model">logistica.ruta</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_f_activas': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Use «Planificar despacho» para proponer rutas con las entregas preparadas.
            </p>
        </field>
    </record>

    <record id="view_logistica_ruta_motivo_form" model="ir.ui.view">
        <field name="name">logistica.ruta.motivo.form</field>
        <field name="model">logistica.ruta.motivo</field>
        <field name="arch" type="xml">
            <form string="Motivo">
                <group>
                    <field name="ruta_id" readonly="1"/>
                    <field name="accion" readonly="1"/>
                    <field name="motivo"/>
                </group>
                <footer>
                    <button name="action_confirmar" string="Confirmar" type="object" class="btn-primary"/>
                    <button string="Volver" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
