<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_logistica_conductor" model="ir.module.category">
        <field name="name">Logística</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_conductor" model="res.groups">
        <field name="name">Conductor de reparto</field>
        <field name="category_id" ref="module_category_logistica_conductor"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Solo ve las rutas, paradas y entregas que le están asignadas.</field>
    </record>

    <!-- Reglas del conductor: cada modelo se limita a lo propio. -->
    <record id="rule_ruta_conductor" model="ir.rule">
        <field name="name">Ruta: el conductor ve solo las suyas</field>
        <field name="model_id" ref="logistica_despacho.model_logistica_ruta"/>
        <field name="groups" eval="[(4, ref('group_conductor'))]"/>
        <field name="domain_force">[('driver_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_parada_conductor" model="ir.rule">
        <field name="name">Parada: el conductor ve solo las de sus rutas</field>
        <field name="model_id" ref="logistica_despacho.model_logistica_ruta_parada"/>
        <field name="groups" eval="[(4, ref('group_conductor'))]"/>
        <field name="domain_force">[('route_id.driver_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_entrega_conductor" model="ir.rule">
        <field name="name">Entrega: el conductor ve solo las de sus rutas</field>
        <field name="model_id" ref="logistica_entregas.model_logistica_entrega"/>
        <field name="groups" eval="[(4, ref('group_conductor'))]"/>
        <field name="domain_force">[('route_stop_ids.route_id.driver_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="rule_evento_conductor" model="ir.rule">
        <field name="name">Evento de entrega: el conductor ve solo los de sus rutas</field>
        <field name="model_id" ref="logistica_entregas.model_logistica_entrega_evento"/>
        <field name="groups" eval="[(4, ref('group_conductor'))]"/>
        <field name="domain_force">[('entrega_id.route_stop_ids.route_id.driver_id', '=', user.partner_id.id)]</field>
    </record>

    <!-- Quien además es personal de flota conserva su acceso completo (las reglas de grupo se suman con OR). -->
    <record id="rule_ruta_flota" model="ir.rule">
        <field name="name">Ruta: personal de flota sin restricción</field>
        <field name="model_id" ref="logistica_despacho.model_logistica_ruta"/>
        <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_parada_flota" model="ir.rule">
        <field name="name">Parada: personal de flota sin restricción</field>
        <field name="model_id" ref="logistica_despacho.model_logistica_ruta_parada"/>
        <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_entrega_flota" model="ir.rule">
        <field name="name">Entrega: personal de flota sin restricción</field>
        <field name="model_id" ref="logistica_entregas.model_logistica_entrega"/>
        <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_evento_flota" model="ir.rule">
        <field name="name">Evento de entrega: personal de flota sin restricción</field>
        <field name="model_id" ref="logistica_entregas.model_logistica_entrega_evento"/>
        <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
