<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_traccar_device_tree" model="ir.ui.view">
        <field name="name">traccar.device.tree</field>
        <field name="model">traccar.device</field>
        <field name="arch" type="xml">
            <tree string="Dispositivos GPS Traccar">
                <field name="name"/>
                <field name="unique_id"/>
                <field name="traccar_id"/>
                <field name="status" widget="badge" decoration-success="status == 'online'" decoration-warning="status == 'offline'" decoration-muted="status == 'unknown'"/>
                <field name="vehicle_id"/>
                <field name="last_latitude"/>
                <field name="last_longitude"/>
                <field name="last_speed"/>
                <field name="last_position_time"/>
            </tree>
        </field>
    </record>

    <record id="view_traccar_device_form" model="ir.ui.view">
        <field name="name">traccar.device.form</field>
        <field name="model">traccar.device</field>
        <field name="arch" type="xml">
            <form string="Dispositivo GPS Traccar">
                <header>
                    <button name="action_fetch_latest_position" string="Actualizar Posición GPS" type="object" class="oe_highlight"/>
                    <field name="status" widget="statusbar" statusbar_visible="online,offline,unknown"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Identificación Traccar">
                            <field name="unique_id"/>
                            <field name="traccar_id"/>
                            <field name="server_id"/>
                        </group>
                        <group string="Asignación Operativa">
                            <field name="vehicle_id"/>
                        </group>
                    </group>
                    <group string="Última Telemetría GPS Recibida">
                        <group>
                            <field name="last_latitude"/>
                            <field name="last_longitude"/>
                        </group>
                        <group>
                            <field name="last_speed"/>
                            <field name="last_position_time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_traccar_device" model="ir.actions.act_window">
        <field name="name">Dispositivos GPS Traccar</field>
        <field name="res_model">traccar.device</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

