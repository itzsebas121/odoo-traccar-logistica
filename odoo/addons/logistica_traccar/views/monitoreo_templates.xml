<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="monitoreo_pagina" name="Monitoreo GPS">
        <t t-call="web.layout">
            <t t-set="title">Monitoreo GPS</t>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <link rel="stylesheet" href="/logistica_base/static/lib/leaflet/leaflet.css"
                      integrity="sha256-M3v8pcq9A7OYFbJwD+vis7ft9VkhxZzUn4jssyghIwM="/>
                <script src="/logistica_base/static/lib/leaflet/leaflet.js"
                        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="></script>
                <script type="text/javascript" src="/logistica_traccar/static/src/js/monitoreo.js"></script>
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&amp;family=JetBrains+Mono:wght@400;500;600;700&amp;display=swap"/>
                <style>
                    html, body { height: 100%; margin: 0; font-family: 'IBM Plex Sans', ui-sans-serif, sans-serif; background: #F8F5EE; color: #141D2B; }
                    #monitoreo-barra { padding: 10px 16px; background: #131B29; color: #FDFBF7; display: flex; gap: 14px; align-items: center; border-bottom: 2px solid #E06D2B; }
                    #monitoreo-barra strong { font-family: 'JetBrains Mono', monospace; font-size: 14px; letter-spacing: 0.04em; text-transform: uppercase; }
                    #monitoreo-barra a { color: #E06D2B; font-family: 'JetBrains Mono', monospace; font-size: 12px; text-decoration: none; font-weight: 600; padding: 4px 10px; border: 1px solid rgba(224,109,43,0.45); border-radius: 6px; }
                    #monitoreo-barra a:hover { background: rgba(224,109,43,0.14); }
                    #monitoreo-mapa { height: calc(100% - 49px); }
                    #monitoreo-aviso { margin-left: auto; font-family: 'JetBrains Mono', monospace; font-size: 0.82em; color: #E8E2D5; }
                </style>
            </t>
            <div id="monitoreo-barra">
                <strong>Monitoreo GPS</strong>
                <a href="/web">Volver a Odoo</a>
                <span id="monitoreo-aviso"></span>
            </div>
            <div id="monitoreo-mapa"></div>
        </t>
    </template>

    <record id="action_logistica_monitoreo" model="ir.actions.act_url">
        <field name="name">Monitoreo GPS</field>
        <field name="url">/logistica/monitoreo</field>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_logistica_monitoreo"
              name="Monitoreo GPS"
              parent="logistica_base.menu_logistica_root"
              action="action_logistica_monitoreo"
              groups="fleet.fleet_group_manager"
              sequence="40"/>
</odoo>
