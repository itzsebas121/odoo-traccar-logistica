# Los valores CAMBIAR_* son marcadores: reemplacelos por contrasenas propias en .env (nunca versione .env).

POSTGRES_USER=odoo
ODOO_DB_PASSWORD=CAMBIAR_odoo_db_password


ODOO_ADMIN_PASSWORD=CAMBIAR_odoo_admin_password

TRACCAR_DB_USER=traccar
TRACCAR_DB_PASSWORD=CAMBIAR_traccar_db_password

TRACCAR_ADMIN_PASSWORD=CAMBIAR_traccar_admin_password

# --- ETL / Data Warehouse (services/etl) ---
# Contrasena del rol de solo lectura dwh_ro (usado por BI/ML). Si se omite o queda vacia, el rol NO se crea
# (el bootstrap avisa) y BI/ML no tendran usuario de lectura.
DWH_DB_PASSWORD=
# OBLIGATORIA para `etl run`: contrasena del usuario `admin` de Odoo (base logistica_dev). No tiene valor por
# defecto: si falta o esta vacia el ETL termina con un error de configuracion.
ODOO_PASSWORD=
# OBLIGATORIA para `etl run`: contrasena del rol etl_stg (base logistica_staging). Sin valor por defecto.
ETL_STG_PASSWORD=
# OBLIGATORIA para `etl run`: contrasena del rol dwh_etl (base logistica_dwh). Sin valor por defecto.
DWH_ETL_PASSWORD=
# Opcional: servicio OSRM para distancias por carretera (si se omite se usa haversine x 1,3)
#ROUTING_OSRM_URL=http://osrm:5000

# --- Host y seeds (Fase 1): scripts/setup y seeds/seed.py leen estas variables de .env; déjelas vacías hasta completarlas ---
# URL de Odoo y de Traccar vistas desde el host (XML-RPC y REST del seeder).
ODOO_URL=
ODOO_DB=
ODOO_USER=
TRACCAR_URL=
# URL con la que Odoo llega a Traccar dentro de la red Docker (el seeder la guarda en traccar.server de Odoo).
TRACCAR_INTERNAL_URL=
# Administrador de Traccar (email). El seeder usa su contrasena (TRACCAR_ADMIN_PASSWORD, arriba).
TRACCAR_ADMIN_EMAIL=
# Usuario de integracion de Traccar (solo lectura, sin administrador; lo crea seeds/seed.py). Contrasena generable con: openssl rand -hex 24
INTEGRATION_TRACCAR_EMAIL=
INTEGRATION_TRACCAR_PASSWORD=
# Receptor OsmAnd para seeds/simular.py. Obligatoria al simular; no tiene valor por defecto.
# Ejemplo, solo desde el host: http://127.0.0.1:5055
TRACCAR_OSMAND_URL=
# Segundos entre posiciones. Vacia o ausente = 0 (el lote sale seguido).
SIM_INTERVALO_S=
# Contrasena inicial de los usuarios conductor que crea seeds/seed.py (portal /logistica/conductor). Obligatoria.
DEMO_CONDUCTOR_PASSWORD=
