# ==============================================================================
# Variables de entorno para Odoo 16 Community y PostgreSQL
# ==============================================================================
# Copie este archivo como .env y defina contraseñas seguras para su entorno local.
# IMPORTANTE: Nunca agregue contraseñas reales en archivos versionados por Git.

# Contraseña de la base de datos PostgreSQL para el usuario 'odoo'
ODOO_DB_PASSWORD=cambiar_por_clave_segura_local

# Contraseña maestra de administración de bases de datos de Odoo (Master Password)
# Odoo solicitará una Master Password para crear, restaurar o borrar bases de datos.
ODOO_ADMIN_PASSWORD=cambiar_por_admin_password_local

