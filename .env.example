# ==============================================================================
# Variables de entorno para Odoo 16 Community, PostgreSQL y Traccar Server
# ==============================================================================
# Copie este archivo como .env y defina contraseñas seguras para su entorno local.
# IMPORTANTE: Nunca agregue contraseñas reales en archivos versionados por Git.

# --- Configuración de PostgreSQL para Odoo ---
POSTGRES_USER=odoo
ODOO_DB_PASSWORD=odoo_pg_pass_dev2026

# --- Contraseña maestra de administración de Odoo (Master Password) ---
ODOO_ADMIN_PASSWORD=odoo_admin_master_pwd_dev2026

# --- Configuración de PostgreSQL para Traccar Server ---
TRACCAR_DB_USER=traccar
TRACCAR_DB_PASSWORD=traccar_pg_pass_dev2026

# --- Contraseña inicial para usuario administrador de Traccar Web ---
TRACCAR_ADMIN_PASSWORD=traccar_admin_pass_dev2026
