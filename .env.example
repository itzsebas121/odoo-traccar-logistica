# Los valores CAMBIAR_* son marcadores: reemplacelos por contrasenas propias en .env (nunca versione .env).

POSTGRES_USER=odoo
ODOO_DB_PASSWORD=CAMBIAR_odoo_db_password


# Clave del usuario admin de Odoo: odoo-init la aplica en cada arranque (Odoo la crea como "admin").
ODOO_ADMIN_PASSWORD=CAMBIAR_odoo_admin_password
# Contrasena maestra del gestor de bases (/web/database/*). Sin ella cualquiera podria fijarla y borrar la base.
ODOO_MASTER_PASSWORD=CAMBIAR_odoo_master_password
# Produccion detras de un proxy inverso (Dokploy/Traefik, nginx): True. Con Odoo publicado directamente
# en un puerto: False (si no, cualquiera podria falsear su IP con X-Forwarded-For).
ODOO_PROXY_MODE=False
# Procesos de Odoo. Con workers > 0 el bus/websocket va por el puerto 8072: el proxy debe enviar
# /websocket a odoo:8072. Desarrollo local sin proxy: 0.
ODOO_WORKERS=2

TRACCAR_DB_USER=traccar
TRACCAR_DB_PASSWORD=CAMBIAR_traccar_db_password

TRACCAR_ADMIN_PASSWORD=CAMBIAR_traccar_admin_password

# --- ETL / Data Warehouse (services/etl) ---
# Contrasena del rol de solo lectura dwh_ro (usado por BI/ML). Si se omite o queda vacia, el rol NO se crea
# (el bootstrap avisa) y BI/ML no tendran usuario de lectura.
DWH_DB_PASSWORD=
# Contrasena del rol dwh_ml (servicio ML): lee el DWH y escribe SOLO las tablas ml_* (comparativa de modelos,
# unidades espaciales y pronosticos). Si queda vacia, el rol no se crea y el ML no guarda resultados en el DWH
# (sigue escribiendo sus archivos en services/ml/analisis y services/ml/models). Sin ella el tablero no muestra
# pronostico: defínala antes de correr `etl bootstrap` y `ml-predecir` en el servidor.
DWH_ML_PASSWORD=
# Contrasena del usuario `admin` de Odoo que usan seeds y ETL. Vacia = ODOO_ADMIN_PASSWORD (recomendado).
ODOO_PASSWORD=
# OBLIGATORIA para `etl run`: contrasena del rol etl_stg (base logistica_staging). Sin valor por defecto.
ETL_STG_PASSWORD=
# OBLIGATORIA para `etl run`: contrasena del rol dwh_etl (base logistica_dwh). Sin valor por defecto.
DWH_ETL_PASSWORD=
# Opcionales del ETL (no son secretos; vacias o ausentes = valor por defecto).
# Minutos entre corridas del servicio etl-scheduler. Por defecto 15.
#ETL_INTERVAL_MIN=15
# Cada cuantas horas el programador hace una corrida completa (detecta registros borrados en Odoo). Por defecto 24.
#ETL_FULL_HOURS=24
# Dias que se conserva el crudo de staging (0 = no se borra). Por defecto 30.
#ETL_RETENTION_DAYS=30
# Dias hacia atras de la primera extraccion de Traccar. Por defecto 30.
#ETL_TRACCAR_DAYS=30
# Segundos de espera por informe de Traccar (subir con mucho historial GPS). Por defecto 30.
#ETL_TRACCAR_TIMEOUT_S=30
# Zona horaria de la operacion (columnas *_local de dim_tiempo). Por defecto America/Guayaquil.
#ETL_TZ=America/Guayaquil
# Opcional: servicio OSRM para distancias por carretera (si se omite se usa haversine x 1,3)
#ROUTING_OSRM_URL=http://osrm:5000

# --- Host y seeds (Fase 1): scripts/setup y seeds/seed.py leen estas variables de .env; déjelas vacías hasta completarlas ---
# URL de Odoo y de Traccar vistas desde el host (XML-RPC y REST del seeder).
ODOO_URL=
ODOO_DB=
ODOO_USER=
TRACCAR_URL=
# URL con la que Odoo llega a Traccar dentro de la red Docker (el seeder la guarda en traccar.server de Odoo).
TRACCAR_INTERNAL_URL=
# Administrador de Traccar (email). El seeder usa su contrasena (TRACCAR_ADMIN_PASSWORD, arriba).
TRACCAR_ADMIN_EMAIL=
# Usuario de integracion de Traccar (solo lectura, sin administrador; lo crea seeds/seed.py). Contrasena generable con: openssl rand -hex 24
INTEGRATION_TRACCAR_EMAIL=
INTEGRATION_TRACCAR_PASSWORD=
# Receptor OsmAnd para seeds/simular.py. Obligatoria al simular; no tiene valor por defecto.
# Ejemplo, solo desde el host: http://127.0.0.1:5055
TRACCAR_OSMAND_URL=
# Segundos entre posiciones. Vacia o ausente = 0 (el lote sale seguido).
SIM_INTERVALO_S=
# Carga del historial de demostracion (3 meses de pedidos, rutas y facturas). false = solo catalogo y clientes.
SEED_HISTORIAL=true
# Contrasena inicial de los usuarios conductor que crea seeds/seed.py (portal /logistica/conductor). Obligatoria.
DEMO_CONDUCTOR_PASSWORD=

# --- Asistente del administrador (services/agente) ---
# Clave de la API de OpenAI (platform.openai.com). Sin ella el chat avisa que falta.
OPENAI_API_KEY=
# Firma de la cookie de sesion. Obligatoria: openssl rand -hex 32
AGENTE_SESSION_SECRET=CAMBIAR_agente_session_secret
# true en produccion (HTTPS). false solo en local por http://localhost:8003
AGENTE_COOKIE_SEGURA=true
# Modelo (familia GPT-6; ver developers.openai.com/api/docs/models) y esfuerzo de razonamiento
# (none | minimal | low | medium | high | xhigh | max, segun el modelo; vacio = no se envia)
AGENTE_MODELO=gpt-6.1-sol
AGENTE_ESFUERZO=medium
# Tamaño máximo de un respaldo subido desde la sección «Base de datos» (MB)
AGENTE_MAX_SUBIDA_MB=2048
